 RowBox[{
  RowBox[{"pdf", "[", "x_", "]"}], ":=", 
  RowBox[{"A", "*", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", "\[Lambda]"}], 
     SuperscriptBox[
      RowBox[{"(", 
