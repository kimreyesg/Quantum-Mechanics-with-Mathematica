Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "Plot", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "lets", " ", "redefine", " ", "the", " ", "funcion", " ", "so", " ", "we", 
    " ", "can", " ", "use", " ", "the", " ", "Manipulate", " ", 
    RowBox[{"command", ":"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"pdfnew", "[", 
    RowBox[{"x_", ",", "a_", ",", "\[Lambda]_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"A", "*", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", "\[Lambda]"}], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"x", "-", "a"}], ")"}], "2"]}]]}], "//.", 
    RowBox[{"{", 
     RowBox[{"A", "\[Rule]", 
      FractionBox[
       SqrtBox["\[Lambda]"], 
       SqrtBox["\[Pi]"]]}], "}"}]}]}]}]], "Input",
 CellLabel->"In[8]:=",ExpressionUUID->"124758b2-856c-4f59-b5fc-73f2bfee910e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"pdfnew", "[", 
        RowBox[{"x", ",", "a", ",", "\[Lambda]"}], "]"}], "//.", 
       RowBox[{"{", 
        RowBox[{"A", "\[Rule]", 
         FractionBox[
          SqrtBox["\[Lambda]"], 
          SqrtBox["\[Pi]"]]}], "}"}]}], "}"}], ",", 
     RowBox[{"{", 
