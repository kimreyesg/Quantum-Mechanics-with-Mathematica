Cell[BoxData[
 RowBox[{
  RowBox[{"$Assumptions", "=", 
   RowBox[{
    RowBox[{"Element", "[", 
     RowBox[{"A", ",", "Reals"}], "]"}], "&&", 
    RowBox[{"Element", "[", 
     RowBox[{"a", ",", "Reals"}], "]"}], "&&", 
    RowBox[{"Element", "[", 
     RowBox[{"\[Lambda]", ",", "Reals"}], "]"}], "&&", 
    RowBox[{"A", ">", "0"}], "&&", 
    RowBox[{"a", ">", "0"}], "&&", 
    RowBox[{"\[Lambda]", ">", "0"}]}]}], ";"}]], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"41e1d3f0-84e7-4e51-8193-614d18bb76bf"],

