Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"mean", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{"x", "*", 
       RowBox[{"pdf", "[", "x", "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"-", "Infinity"}], ",", "Infinity"}], "}"}]}], "]"}], "/.", 
    RowBox[{"{", 
     RowBox[{"A", "\[Rule]", 
      FractionBox[
       SqrtBox["\[Lambda]"], 
       SqrtBox["\[Pi]"]]}], "}"}]}], "//", "Simplify"}]}]], "Input",
 CellChangeTimes->{{3.934638182125677*^9, 3.9346381918427773`*^9}, {
  3.950524961882167*^9, 3.950524966974345*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"e45035e2-2b4a-42ef-b3e6-c3720ce5a809"],

Cell[BoxData["a"], "Output",
 CellChangeTimes->{3.954496933726688*^9},
 CellLabel->"Out[5]=",ExpressionUUID->"c547bd89-45c7-4a5e-a81a-b5529e70e018"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"SQmean", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{
       SuperscriptBox["x", "2"], "*", 
       RowBox[{"pdf", "[", "x", "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"-", "Infinity"}], ",", "Infinity"}], "}"}]}], "]"}], "/.", 
    RowBox[{"{", 
     RowBox[{"A", "\[Rule]", 
      FractionBox[
       SqrtBox["\[Lambda]"], 
       SqrtBox["\[Pi]"]]}], "}"}]}], "//", "Simplify"}]}]], "Input",
 CellLabel->"In[6]:=",ExpressionUUID->"fd1d683e-0541-4d6b-9972-14a0f5d61670"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox["a", "2"], "+", 
  FractionBox["1", 
   RowBox[{"2", " ", "\[Lambda]"}]]}]], "Output",
 CellChangeTimes->{3.954496939252343*^9},
 CellLabel->"Out[6]=",ExpressionUUID->"3eccc215-1534-4fd1-a946-80287e974148"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"std", "=", 
  RowBox[{
   RowBox[{
    SqrtBox[
     RowBox[{"SQmean", "-", 
      SuperscriptBox["mean", "2"]}]], "/.", 
    RowBox[{"{", 
     RowBox[{"A", "\[Rule]", 
      FractionBox[
       SqrtBox["\[Lambda]"], 
       SqrtBox["\[Pi]"]]}], "}"}]}], "//", "Simplify"}]}]], "Input",
 CellLabel->"In[7]:=",ExpressionUUID->"b7e1161a-61aa-42b6-b11e-869d4f099419"],

Cell[BoxData[
 FractionBox["1", 
  RowBox[{
   SqrtBox["2"], " ", 
   SqrtBox["\[Lambda]"]}]]], "Output",
 CellChangeTimes->{3.95449694290781*^9},
 CellLabel->"Out[7]=",ExpressionUUID->"9c569be8-551b-4fc2-9e69-97e342e30bc3"]
}, Open  ]],

