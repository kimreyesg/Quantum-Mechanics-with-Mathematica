Notebook[{

Cell[CellGroupData[{
Cell["Quantum Measurement Simulation:", "Subsection",
 CellChangeTimes->{{3.951321990720945*^9, 3.951321991722649*^9}, {
   3.951322097677526*^9, 3.951322102225971*^9}, 
   3.955190570989255*^9},ExpressionUUID->"6f89ce74-bcb3-4f89-b3ae-\
63d9cff352d6"],

Cell[BoxData["Quit"], "Input",
 CellChangeTimes->{{3.955190608723762*^9, 3.955190608799492*^9}},
 CellLabel->"In[17]:=",ExpressionUUID->"3bad899f-64af-4f1e-9833-019656cb7d67"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Simulating", " ", "the", " ", "collapse", " ", "of", " ", "the", " ", 
    "wave", " ", "function", " ", "upon", " ", "measurement"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"n", "=", "3"}], ";", 
    RowBox[{"L", "=", "1"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"\[Psi]", "[", 
     RowBox[{"x_", ",", "n_", ",", "L_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{"2", "/", "L"}], "]"}], " ", 
     RowBox[{"Sin", "[", 
      RowBox[{"n", " ", "\[Pi]", " ", 
       RowBox[{"x", "/", "L"}]}], "]"}]}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Create", " ", "a", " ", "function", " ", "that", " ", "generates", " ", 
     "random", " ", "positions", " ", "based", " ", "on", " ", "probability", 
     " ", "density"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"measurementDemo", "[", "numMeasurements_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"results", ",", "pdf", ",", "dist"}], "}"}], ",", 
      RowBox[{"(*", 
       RowBox[{
       "Define", " ", "probability", " ", "density", " ", "function"}], 
       "*)"}], 
      RowBox[{
       RowBox[{
        RowBox[{"pdf", "[", "x_", "]"}], ":=", 
        RowBox[{
         RowBox[{"\[Psi]", "[", 
          RowBox[{"x", ",", "n", ",", "L"}], "]"}], "^", "2"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Create", " ", "a", " ", "probability", " ", "distribution"}],
         "*)"}], 
       RowBox[{"dist", "=", 
        RowBox[{"ProbabilityDistribution", "[", 
         RowBox[{
          RowBox[{"pdf", "[", "x", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "0", ",", "L"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Generate", " ", "random", " ", "measurements", " ", "according", " ",
          "to", " ", "the", " ", "probability", " ", "distribution"}], "*)"}], 
       RowBox[{"results", "=", 
        RowBox[{"RandomVariate", "[", 
         RowBox[{"dist", ",", "numMeasurements"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Display", " ", "results", " ", "as", " ", "a", " ", "histogram", " ",
          "with", " ", "overlaid", " ", "theoretical", " ", "curve"}], "*)"}], 
       RowBox[{"Histogram", "[", 
        RowBox[{"results", ",", "20", ",", "\"\<PDF\>\"", ",", 
         RowBox[{
         "PlotLabel", "->", 
          "\"\<Measurement Results vs. Probability Density\>\""}], ",", 
         RowBox[{"AxesLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<Position\>\"", ",", "\"\<Probability\>\""}], "}"}]}], 
         ",", 
         RowBox[{"PlotRange", "->", "All"}], ",", 
         RowBox[{"Epilog", "->", 
          RowBox[{"{", 
           RowBox[{"Red", ",", "Thick", ",", 
            RowBox[{
             RowBox[{"Plot", "[", 
              RowBox[{
               RowBox[{"pdf", "[", "x", "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", 
               RowBox[{"PlotRange", "->", "All"}]}], "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}]}], "]"}]}]}], "]"}]}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Run", " ", "the", " ", "simulation", " ", "with", " ", "1000", " ", 
     "measurements"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"measurementDemo", "[", "100000", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9513221075418987`*^9, 3.9513221156268797`*^9}, {
  3.955190583399075*^9, 3.9551906433036757`*^9}},
 CellLabel->"In[17]:=",ExpressionUUID->"3d8214ed-356a-4fb6-8e97-b1d8f526e045"],

