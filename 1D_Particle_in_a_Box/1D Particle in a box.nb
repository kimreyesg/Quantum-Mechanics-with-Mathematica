Notebook[{

Cell[CellGroupData[{
Cell["Wave Functions and Probability", "Subsection",
 CellChangeTimes->{3.950521163046818*^9, 3.950525405214325*^9, 
  3.9551902242364063`*^9},ExpressionUUID->"fdaaee14-ed07-4442-b194-\
4db37c8c209e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Visualizing", " ", "a", " ", "1", "D", " ", "particle", " ", "in", " ", 
    "a", " ", "box", " ", "wave", " ", "function"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"n", "=", "1"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"quantum", " ", "number"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"L", "=", "1"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"box", " ", "length"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"\[Psi]", "[", 
     RowBox[{"x_", ",", "n_", ",", "L_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{"2", "/", "L"}], "]"}], " ", 
     RowBox[{"Sin", "[", 
      RowBox[{"n", " ", "\[Pi]", " ", 
       RowBox[{"x", "/", "L"}]}], "]"}]}]}], "\n", 
   RowBox[{
    RowBox[{"prob", "[", 
     RowBox[{"x_", ",", "n_", ",", "L_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"\[Psi]", "[", 
      RowBox[{"x", ",", "n", ",", "L"}], "]"}], "^", "2"}]}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Psi]", "[", 
        RowBox[{"x", ",", "n", ",", "L"}], "]"}], ",", 
       RowBox[{"prob", "[", 
        RowBox[{"x", ",", "n", ",", "L"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Wave Function\>\"", ",", "\"\<Probability Density\>\""}], 
       "}"}]}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Position\>\"", ",", "\"\<Amplitude\>\""}], "}"}]}]}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.950521174127211*^9, 3.9505211741304913`*^9}, {
  3.950521221816811*^9, 3.950521246460011*^9}, {3.9505258248092537`*^9, 
  3.950525825178792*^9}, {3.951827777954726*^9, 3.95182779117024*^9}, {
