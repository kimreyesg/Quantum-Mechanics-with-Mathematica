Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{
   "The", " ", "narrower", " ", "your", " ", "initial", " ", "position", " ", 
    "distribution", " ", 
    RowBox[{"(", 
     RowBox[{"smaller", " ", "\[CapitalDelta]x"}], ")"}]}], ",", 
   RowBox[{
   "the", " ", "wider", " ", "your", " ", "momentum", " ", "distribution", 
    " ", "must", " ", "be", " ", 
    RowBox[{"(", 
     RowBox[{"larger", " ", "\[CapitalDelta]p"}], ")"}], " ", "to", " ", 
    "satisfy", " ", "the", " ", "uncertainty", " ", 
    RowBox[{"principle", ".", "A"}], " ", "wider", " ", "momentum", " ", 
    "distribution", " ", "means", " ", "more", " ", "extreme", " ", 
    "differences", " ", "in", " ", "velocity", " ", "components"}], ",", 
   RowBox[{
    RowBox[{
    "which", " ", "leads", " ", "to", " ", "faster", " ", "spreading", " ", 
     "of", " ", "the", " ", "wave", " ", 
     RowBox[{"packet", ".", "The"}], " ", "uncertainty", " ", "principle", 
     " ", 
     RowBox[{"isn", "'"}], "t", " ", "just", " ", "a", " ", "limitation", " ",
      "on", " ", "measurement"}], "-", 
    RowBox[{
     RowBox[{"it", "'"}], "s", " ", "a", " ", "fundamental", " ", "property", 
     " ", "of", " ", "wave"}], "-", 
    RowBox[{"like", " ", "entities", " ", "that", " ", "has", " ", "real"}]}],
    ",", 
   RowBox[{
   "observable", " ", "consequences", " ", "like", " ", "wave", " ", "packet",
     " ", 
    RowBox[{"spreading", ".", "This"}], " ", "is", " ", "why", " ", "free", 
    " ", "particles", " ", "always", " ", "spread", " ", "out", " ", "in", 
    " ", "quantum", " ", "mechanics"}], ",", 
   RowBox[{
   "while", " ", "in", " ", "classical", " ", "mechanics", " ", "a", " ", 
    "free", " ", "particle", " ", "would", " ", "maintain", " ", "its", " ", 
    "shape", " ", 
    RowBox[{"forever", ".", "\[IndentingNewLine]", "The"}], " ", 
    "uncertainty", " ", "principle", " ", "itself", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"\[CapitalDelta]x", "\[CenterDot]", "\[CapitalDelta]p"}], 
      "\[GreaterEqual]", 
      RowBox[{"\:0127", "/", "2"}]}], ")"}], " ", 
    RowBox[{"doesn", "'"}], "t", " ", "explicitly", " ", "involve", " ", 
    "time"}], ",", 
   RowBox[{
   "but", " ", "time", " ", "plays", " ", "a", " ", "critical", " ", "role", 
    " ", "in", " ", "how", " ", "the", " ", "uncertainty", " ", "principle", 
    " ", "manifests", " ", "in", " ", "wave", " ", "packet", " ", 
    RowBox[{"evolution", ":", 
     RowBox[{"Initial", " ", "condition", " ", 
      RowBox[{"(", 
       RowBox[{"t", "=", "0"}], ")"}]}], ":", 
     RowBox[{
     "We", " ", "start", " ", "with", " ", "a", " ", "localized", " ", "wave",
       " ", "packet", " ", "with", " ", "position", " ", "uncertainty", " ", 
      "\[CapitalDelta]x", "\n", "Due", " ", "to", " ", "the", " ", 
      "uncertainty", " ", "principle"}]}]}], ",", 
   RowBox[{
    RowBox[{
    "this", " ", "gives", " ", "us", " ", "momentum", " ", "uncertainty", " ",
      "\[CapitalDelta]p", "\[IndentingNewLine]", "Time", " ", 
     RowBox[{"evolution", ":", 
      RowBox[{"At", " ", "t"}]}]}], "=", "0"}], ",", 
   RowBox[{
   "different", " ", "momentum", " ", "components", " ", "are", " ", "all", 
    " ", "aligned", " ", "in", " ", "phase", "\n", "As", " ", "time", " ", 
    "passes"}], ",", 
   RowBox[{
   "these", " ", "components", " ", "evolve", " ", "at", " ", "different", 
    " ", "rates", "\n", "For", " ", "a", " ", "free", " ", "particle"}], ",", 
   
   RowBox[{
    RowBox[{"the", " ", "phase", " ", "evolution", " ", "is", " ", 
     RowBox[{"e", "^", 
      RowBox[{"(", 
       RowBox[{"iEt", "/", "\:0127"}], ")"}]}]}], "=", 
    RowBox[{
     RowBox[{"e", "^", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"ip\.b2t", "/", "2"}], "m\:0127"}], ")"}]}], 
     "\[IndentingNewLine]", "This", " ", "reveals", " ", "a", " ", "profound",
      " ", 
     RowBox[{"point", ":", 
      RowBox[{
       RowBox[{
       "the", " ", "uncertainty", " ", "principle", " ", "forces", " ", "an", 
        " ", "initially", " ", "well"}], "-", 
       RowBox[{
       "localized", " ", "state", " ", "to", " ", "become", " ", 
        "increasingly", " ", "delocalized", " ", "as", " ", "time", " ", 
        RowBox[{"progresses", ".", "You"}], " ", "can", " ", "think", " ", 
        "of", " ", "it", " ", "as", " ", "the", " ", "\"\<cost\>\"", " ", 
        "of", " ", "having", " ", "violated", " ", "the", " ", "equilibrium", 
        " ", "balance", " ", "between", " ", "position", " ", "and", " ", 
        "momentum", " ", "uncertainty", " ", "being", " ", "paid", " ", 
        "back", " ", "over", " ", 
        RowBox[{"time", "."}]}]}]}]}]}]}], "*)"}]], "Input",
 CellChangeTimes->{{3.951324124818638*^9, 3.9513241261024733`*^9}, 
   3.951324445956568*^9, {3.9513245503262568`*^9, 
