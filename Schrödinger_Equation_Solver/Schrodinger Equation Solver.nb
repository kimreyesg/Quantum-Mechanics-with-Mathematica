Notebook[{

Cell[CellGroupData[{
Cell["Schr\[ODoubleDot]dinger Equation Solver Tool:", "Subsection",
 CellChangeTimes->{{3.9513221562178392`*^9, 3.951322166444096*^9}, 
   3.955190779640238*^9},ExpressionUUID->"930dbed8-7880-490a-afbb-\
4644e800d001"],

Cell["\<\
This code simulates and visualizes the time evolution of a quantum wave \
function (starting as a Gaussian wave packet) as it moves through different \
potential landscapes.
The process works like this:

Initial State: We start with a Gaussian wave packet (the gaussianPacket \
function), which represents a quantum particle with a reasonably well-defined \
position and momentum. In the example, it starts at position -5 with a \
positive momentum (moving to the right).
Time Evolution: The Schr\[ODoubleDot]dinger equation solver then calculates \
how this wave packet evolves over time according to the time-dependent Schr\
\[ODoubleDot]dinger equation:
i\[CenterDot]\:0127\[CenterDot]\[PartialD]\[Psi]/\[PartialD]t = \
-\:0127\.b2/(2m)\[CenterDot]\[PartialD]\.b2\[Psi]/\[PartialD]x\.b2 + V(x)\
\[CenterDot]\[Psi]
Potential Influence: The potential function (potentialFunc) affects how the \
wave packet moves and changes. Different potentials produce different \
behaviors:

Free particle: The wave packet simply spreads out while moving
Barrier: The wave packet partially reflects and partially tunnels through
Harmonic oscillator: The wave packet oscillates back and forth
Double well: The wave packet can tunnel between the two wells


Visualization: The animation shows the probability density (|\[Psi]|\.b2) \
over time, which tells you the probability of finding the particle at \
different positions as time passes.

This is a powerful tool for teaching quantum mechanics because it lets \
students see quantum phenomena like:

Wave packet spreading
Quantum tunneling
Quantum reflection
Quantum superposition
Wave-like behavior of particles
\
\>", "Text",
 CellChangeTimes->{
  3.9513230302501297`*^9, {3.9513230613487787`*^9, 3.9513230708486433`*^9}, {
   3.9513231751861267`*^9, 
   3.951323175920763*^9}},ExpressionUUID->"3f49db7f-961d-4a96-a43c-\
ea62604a4145"],

Cell[BoxData["Quit"], "Input",
 CellChangeTimes->{{3.951322374282097*^9, 3.951322374865548*^9}},
 CellLabel->"In[24]:=",ExpressionUUID->"c68717b4-f0bf-438e-893a-6561c6fd8e22"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Set", " ", "up", " ", "natural", " ", "units"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\:0127", "=", "1"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"m", "=", "1"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Define", " ", "a", " ", "function", " ", "to", " ", "solve", " ", "and",
       " ", "visualize", " ", "the", " ", "time"}], "-", 
     RowBox[{"dependent", " ", "Schr\[ODoubleDot]dinger", " ", "equation"}]}],
     "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"solveSchrodinger", "[", 
     RowBox[{"potentialFunc_", ",", "initialState_", ",", "tMax_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"psi", ",", "x", ",", "t", ",", 
        RowBox[{"xMin", "=", 
         RowBox[{"-", "10"}]}], ",", 
        RowBox[{"xMax", "=", "10"}], ",", "sol", ",", "normConst", ",", 
        "potentialPlot", ",", "maxPotential"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Ensure", " ", "the", " ", "domain", " ", "is", " ", "appropriate"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"xMin", "=", 
        RowBox[{"-", "10"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"xMax", "=", "10"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Find", " ", "maximum", " ", "potential", " ", "value", " ", "for", 
         " ", "scaling"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"maxPotential", "=", 
        RowBox[{"Max", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"potentialFunc", "[", "x", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "xMin", ",", "xMax", ",", "0.1"}], "}"}]}], 
          "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"maxPotential", "==", "0"}], ",", 
         RowBox[{"maxPotential", "=", "1"}]}], "]"}], ";", 
       RowBox[{"(*", 
        RowBox[{"Avoid", " ", "division", " ", "by", " ", "zero"}], "*)"}], 
       RowBox[{"(*", 
        RowBox[{
        "Create", " ", "a", " ", "plot", " ", "of", " ", "the", " ", 
         "potential", " ", "for", " ", "reference"}], "*)"}], 
       RowBox[{"potentialPlot", "=", 
        RowBox[{"Plot", "[", 
         RowBox[{
          RowBox[{"potentialFunc", "[", "x", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "xMin", ",", "xMax"}], "}"}], ",", 
          RowBox[{"PlotStyle", "->", 
           RowBox[{"{", 
            RowBox[{"Thick", ",", "Red"}], "}"}]}], ",", 
          RowBox[{"PlotRange", "->", "All"}], ",", 
          RowBox[{"PlotLabel", "->", "\"\<Potential Energy Function\>\""}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Show", " ", "the", " ", "potential", " ", "first"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", "\"\<Potential Energy Function:\>\"", "]"}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"Print", "[", "potentialPlot", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Solve", " ", "the", " ", "time"}], "-", 
         RowBox[{
         "dependent", " ", "Schr\[ODoubleDot]dinger", " ", "equation"}]}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{
       "Print", "[", 
        "\"\<Solving the Schr\[ODoubleDot]dinger equation...\>\"", "]"}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"sol", "=", 
        RowBox[{"NDSolve", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{
              RowBox[{"Time", "-", 
               RowBox[{
               "dependent", " ", "Schr\[ODoubleDot]dinger", " ", "equation", 
                " ", "with", " ", "\:0127"}]}], "=", "1"}], ",", 
             RowBox[{"m", "=", "1"}]}], "*)"}], 
           RowBox[{
            RowBox[{
             RowBox[{"I", "*", 
              RowBox[{"D", "[", 
               RowBox[{
                RowBox[{"psi", "[", 
                 RowBox[{"x", ",", "t"}], "]"}], ",", "t"}], "]"}]}], "==", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "0.5"}], "*", 
               RowBox[{"D", "[", 
                RowBox[{
                 RowBox[{"psi", "[", 
                  RowBox[{"x", ",", "t"}], "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"x", ",", "2"}], "}"}]}], "]"}]}], "+", 
              RowBox[{
               RowBox[{"potentialFunc", "[", "x", "]"}], "*", 
               RowBox[{"psi", "[", 
                RowBox[{"x", ",", "t"}], "]"}]}]}]}], ",", 
            RowBox[{"(*", 
             RowBox[{"Initial", " ", "condition"}], "*)"}], 
            RowBox[{
             RowBox[{"psi", "[", 
              RowBox[{"x", ",", "0"}], "]"}], "==", 
             RowBox[{"initialState", "[", "x", "]"}]}], ",", 
            RowBox[{"(*", 
             RowBox[{"Boundary", " ", "conditions", " ", 
              RowBox[{"(", 
               RowBox[{
               "wave", " ", "function", " ", "vanishes", " ", "at", " ", 
                "boundaries"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"psi", "[", 
              RowBox[{"xMin", ",", "t"}], "]"}], "==", "0"}], ",", 
            RowBox[{
             RowBox[{"psi", "[", 
              RowBox[{"xMax", ",", "t"}], "]"}], "==", "0"}]}], "}"}], ",", 
          "psi", ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "xMin", ",", "xMax"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "0", ",", "tMax"}], "}"}], ",", 
          RowBox[{"Method", "->", 
           RowBox[{"{", 
            RowBox[{"\"\<MethodOfLines\>\"", ",", 
             RowBox[{"\"\<SpatialDiscretization\>\"", "->", 
              RowBox[{"{", 
               RowBox[{"\"\<TensorProductGrid\>\"", ",", 
                RowBox[{"\"\<MinPoints\>\"", "->", "100"}]}], "}"}]}]}], 
            "}"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Create", " ", "an", " ", "animation", " ", "of", " ", "the", " ", 
         "probability", " ", "density"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{
       "Print", "[", "\"\<Time evolution of the probability density:\>\"", 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Animate", "[", 
        RowBox[{
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "currentDensity", ",", "maxDensity", ",", "scaledPotential"}], 
            "}"}], ",", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
            "Get", " ", "the", " ", "current", " ", "probability", " ", 
             "density"}], "*)"}], "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"currentDensity", "=", 
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{
                RowBox[{"psi", "[", 
                 RowBox[{"x", ",", "tCurrent"}], "]"}], "/.", " ", "sol"}], 
               "]"}], "^", "2"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
             "Scale", " ", "the", " ", "potential", " ", "for", " ", 
              "visualization"}], "*)"}], "\[IndentingNewLine]", 
            RowBox[{"scaledPotential", "=", 
             RowBox[{
              RowBox[{
               RowBox[{"potentialFunc", "[", "x", "]"}], "/", 
               "maxPotential"}], "*", "0.8"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{"Create", " ", "the", " ", "plot"}], "*)"}], 
            "\[IndentingNewLine]", 
            RowBox[{"Plot", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"scaledPotential", ",", "currentDensity"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"x", ",", "xMin", ",", "xMax"}], "}"}], ",", 
              RowBox[{"PlotRange", "->", 
               RowBox[{"{", 
                RowBox[{"0", ",", "1"}], "}"}]}], ",", 
              RowBox[{"PlotStyle", "->", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"Thick", ",", "Dashed", ",", "Gray"}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"Thick", ",", "Blue"}], "}"}]}], "}"}]}], ",", 
              RowBox[{"Filling", "->", 
               RowBox[{"{", 
                RowBox[{"2", "->", "0"}], "}"}]}], ",", 
              RowBox[{"FillingStyle", "->", 
               RowBox[{"Opacity", "[", 
                RowBox[{"0.2", ",", "Blue"}], "]"}]}], ",", 
              RowBox[{"AxesLabel", "->", 
               RowBox[{"{", 
                RowBox[{
                "\"\<Position\>\"", ",", "\"\<Probability Density\>\""}], 
                "}"}]}], ",", 
              RowBox[{"PlotLegends", "->", 
               RowBox[{"{", 
                RowBox[{
                "\"\<Scaled Potential\>\"", ",", 
                 "\"\<Probability Density\>\""}], "}"}]}], ",", 
              RowBox[{"PlotLabel", "->", 
               RowBox[{"\"\<Time = \>\"", "<>", 
                RowBox[{"ToString", "[", 
                 RowBox[{"NumberForm", "[", 
                  RowBox[{"tCurrent", ",", 
                   RowBox[{"{", 
                    RowBox[{"4", ",", "2"}], "}"}]}], "]"}], "]"}]}]}], ",", 
              RowBox[{"GridLines", "->", "Automatic"}], ",", 
              RowBox[{"ImageSize", "->", "600"}]}], "]"}]}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"tCurrent", ",", "0", ",", "tMax", ",", 
           RowBox[{"tMax", "/", "50"}]}], "}"}], ",", 
         RowBox[{"AnimationRate", "->", "1"}], ",", 
         RowBox[{"DisplayAllSteps", "->", "False"}], ",", 
         RowBox[{"AnimationRunning", "->", "False"}]}], "]"}]}]}], "]"}]}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Example", " ", 
     RowBox[{"usage", ":", 
      RowBox[{
      "Free", " ", "particle", " ", "Gaussian", " ", "wave", " ", 
       "packet"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Define", " ", "initial", " ", "Gaussian", " ", "wave", " ", "packet"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gaussianPacket", "[", "x_", "]"}], ":=", 
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"x", "+", "5"}], ")"}], "^", "2"}]}], "/", "2"}], "]"}], 
     "*", 
     RowBox[{"Exp", "[", 
      RowBox[{"I", "*", "2", "*", "x"}], "]"}]}]}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Define", " ", "a", " ", "few", " ", "example", " ", "potentials"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"freeParticle", "[", "x_", "]"}], ":=", "0"}], "\n", 
   RowBox[{
    RowBox[{"barrier", "[", "x_", "]"}], ":=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", "x", "]"}], "<", "1"}], ",", "5", ",", "0"}], 
     "]"}]}], "\n", 
   RowBox[{
    RowBox[{"harmonicOscillator", "[", "x_", "]"}], ":=", 
    RowBox[{"0.1", "*", 
     RowBox[{"x", "^", "2"}]}]}], "\n", 
   RowBox[{
    RowBox[{"doublePotentialWell", "[", "x_", "]"}], ":=", 
    RowBox[{"0.5", "*", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"x", "^", "2"}], "-", "4"}], ")"}], "^", "2"}]}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Usage", " ", "examples"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Uncomment", " ", "one", " ", "of", " ", "these", " ", "lines", " ", "to",
      " ", 
     RowBox[{"run", ":"}]}], "*)"}], "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.951322334936995*^9, 3.951322351290762*^9}, {
   3.9513224707792664`*^9, 3.951322529024983*^9}, {3.951322570762809*^9, 
