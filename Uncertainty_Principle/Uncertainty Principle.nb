                RowBox[{"Opacity", "[", 
                 RowBox[{"0.2", ",", "Blue"}], "]"}]}], ",", 
               RowBox[{"ImageSize", "->", "300"}]}], "]"}], ",", 
             RowBox[{"Plot", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"\[Psi]p", "[", 
                 RowBox[{"p", ",", "\[Sigma]x0"}], "]"}], "^", "2"}], ",", 
               RowBox[{"{", 
                RowBox[{"p", ",", 
                 RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", 
               RowBox[{"PlotLabel", "->", "\"\<Momentum Space\>\""}], ",", 
               RowBox[{"PlotRange", "->", 
                RowBox[{"{", 
                 RowBox[{"0", ",", "1"}], "}"}]}], ",", 
               RowBox[{"AxesLabel", "->", 
                RowBox[{"{", 
                 RowBox[{"\"\<Momentum\>\"", ",", "\"\<Probability\>\""}], 
                 "}"}]}], ",", 
               RowBox[{"PlotStyle", "->", "Red"}], ",", 
               RowBox[{"Filling", "->", "Axis"}], ",", 
               RowBox[{"FillingStyle", "->", 
                RowBox[{"Opacity", "[", 
                 RowBox[{"0.2", ",", "Red"}], "]"}]}], ",", 
               RowBox[{"ImageSize", "->", "300"}]}], "]"}]}], "}"}], "}"}], 
          "]"}]}], "}"}], "]"}]}], ",", 
