           "\"\<Momentum spread (\[Sigma]p): \>\"", ",", "\[Sigma]p"}], "}"}],
           "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{
           "\"\<Product (\[Sigma]x\[CenterDot]\[Sigma]p): \>\"", ",", 
            RowBox[{"\[Sigma]x0", "*", "\[Sigma]p"}], ",", 
            "\"\< \[GreaterEqual] \[HBar]/2 = \>\"", ",", 
            RowBox[{"\:0127", "/", "2"}]}], "}"}], "]"}], ",", 
         RowBox[{"(*", 
          RowBox[{"Create", " ", "the", " ", "plots"}], "*)"}], 
         RowBox[{"Grid", "[", 
          RowBox[{"{", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Plot", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"\[Psi]x", "[", 
