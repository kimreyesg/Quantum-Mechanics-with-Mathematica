     RowBox[{"Gaussian", " ", "wave", " ", "packet"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"\[Psi]x", "[", 
     RowBox[{"x_", ",", "\[Sigma]x_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"2", " ", "\[Pi]", " ", 
        RowBox[{"\[Sigma]x", "^", "2"}]}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "/", "4"}], ")"}]}], " ", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"x", "^", "2"}]}], "/", 
       RowBox[{"(", 
        RowBox[{"4", " ", 
         RowBox[{"\[Sigma]x", "^", "2"}]}], ")"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Momentum", " ", "space", " ", "wave", " ", "function", " ", 
     RowBox[{"(", 
      RowBox[{"analytical", " ", "form", " ", "for", " ", "Gaussian"}], 
      ")"}]}], "*)"}], "\n", 
